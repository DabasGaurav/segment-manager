# Postgres (Neon in production). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://postgres@localhost:5432/segment_manager"
DIRECT_URL="postgresql://postgres@localhost:5432/segment_manager"
# At least 32 random characters. Signs demo session tokens.
SESSION_SECRET="replace-with-32+-random-characters-xxxxxxxx"
# Enables the seeded demo personas and the role switcher. Never enable on a real tenant.
DEMO_MODE="true"
# Service key the bidder (and the UI's server-side lab route) uses for /v1/resolve. Only its hash is stored.
BIDDER_SERVICE_KEY="sm_live_replace_me_with_a_long_random_value"
# Read-only key published in the README so evaluators can curl /v1/resolve on the demo tenant.
DEMO_READONLY_KEY="sm_demo_readonly_replace_me"
