{
  "name": "segment-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Segment Manager: internal API that validates, translates and policy-gates publisher targeting signals (Media.net APM case prototype).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && tsx scripts/prepare-db.ts && tsx scripts/fetch-gvl.ts && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "taxonomy:verify": "tsx scripts/verify-taxonomies.ts",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@iabtechlabtcf/core": "1.5.22",
    "@prisma/client": "6.19.3",
    "jose": "6.2.18",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
